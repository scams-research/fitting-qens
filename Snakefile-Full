    name: "experimental_nested_sampling_anisotropic_sampler"
    input:
        "src/code/experiment_nested_sampling/aniso/sampler.py",
        "src/code/experiment_nested_sampling/aniso/runner.py",
        "src/code/experiment_nested_sampling/utility/bounds.py",
        "src/code/experiment_nested_sampling/utility/data.py",
        "src/code/experiment_nested_sampling/utility/model.py",
        "src/code/experiment_nested_sampling/utility/paths.py",
        "src/data/pLET_aniso_model.pkl",
        "src/data/pLET_benzene_290K_360_inc.nxspe",
