rule:
    conda: "fitting-qens"
    name: "experimental_nested_sampling_isotropic_sampler"
    input:
        "src/code/experiment_nested_sampling/iso/sampler.py",
        "src/code/experiment_nested_sampling/iso/runner.py",
        "src/code/experiment_nested_sampling/utility/bounds.py",
