models = ['model_nogauss_oneexp', 'model_nogauss_twoexp', 'model_nogauss_oneexpgauss', 'model_nogauss_twoexpgauss', 'model_gauss_oneexp', 'model_gauss_twoexp', 'model_gauss_oneexpgauss', 'model_gauss_twoexpgauss']

rule all:
    input:
        [f"src/data/{i}.pkl" for i in models],
         "src/data/lit_approach.pkl"

rule:
    conda: "fitting-qens"
    name: "experimental_nested_sampling_anisotropic"
    input:
        "src/code/experiment_nested_sampling/aniso/runner.py",
        "src/code/experiment_nested_sampling/utility/bounds.py",
        "src/code/experiment_nested_sampling/utility/data.py",
        "src/code/experiment_nested_sampling/utility/model.py",
        "src/code/experiment_nested_sampling/utility/paths.py",
        "src/data/pLET_benzene_290K_360_inc.nxspe",
        "src/data/pLET_empty_360_inc.nxspe",
        "src/data/pLET_benzene_290K_197_inc.nxspe",
        "src/data/pLET_empty_197_inc.nxspe",
    output:
        "src/data/pLET_aniso_model.pkl"
    shell:
        "python {input[0]}"


